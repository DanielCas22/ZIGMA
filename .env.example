# Configuración de Entorno - ZIGMA
# Copia este archivo como .env y ajusta según tu entorno

# ============================================================
# CONFIGURACIÓN DE BASE DE DATOS
# ============================================================

DB_HOST=localhost
DB_PORT=3306
DB_NAME=zigmaog
DB_USER=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# ============================================================
# CONFIGURACIÓN DEL SERVIDOR
# ============================================================

# URL base de la aplicación
APP_URL=http://localhost/ZIGMA/public/

# Nombre de la aplicación
APP_NAME=ZIGMA

# Entorno (development, production)
APP_ENV=development

# ============================================================
# CONFIGURACIÓN DE SESIONES
# ============================================================

# Duración de la sesión en minutos
SESSION_LIFETIME=480

# Camino de la cookie
SESSION_PATH=/ZIGMA

# ============================================================
# PARÁMETROS LEGALES POR DEFECTO (2025)
# ============================================================

# Salario Mínimo Legal Vigente
DEFAULT_SMLV=1300000

# Unidad de Valor Tributario
DEFAULT_UVT=45286.00

# Auxilio de Transporte
DEFAULT_AUXILIO_TRANSPORTE=162000

# Año de vigencia
YEAR_VIGENCIA=2025

# ============================================================
# PARÁMETROS DE APORTES Y COTIZACIONES
# ============================================================

# Salud
HEALTH_EMPLOYER_PERCENTAGE=8.50
HEALTH_EMPLOYEE_PERCENTAGE=4.00

# Pensión
PENSION_EMPLOYER_PERCENTAGE=12.00
PENSION_EMPLOYEE_PERCENTAGE=4.00

# Parafiscales
PARAFISCAL_PERCENTAGE=9.00

# SENA
SENA_PERCENTAGE=2.00

# ICBF
ICBF_PERCENTAGE=3.00

# Prestaciones
BENEFITS_PERCENTAGE=8.33

# ============================================================
# CONFIGURACIÓN DE SEGURIDAD
# ============================================================

# Hash password salt (para bcrypt)
PASSWORD_HASH_COST=10

# Token expiration (minutos)
TOKEN_EXPIRATION=1440

# ============================================================
# CONFIGURACIÓN DE LOGS
# ============================================================

# Nivel de log (debug, info, warning, error)
LOG_LEVEL=info

# Ruta de logs
LOG_PATH=./logs/

# ============================================================
# CONFIGURACIÓN DE REPORTES
# ============================================================

# Formato de reportes (pdf, excel, html)
REPORT_FORMAT=pdf

# Ruta para guardar reportes
REPORT_PATH=./reportes/

# ============================================================
# CONFIGURACIÓN DE ARCHIVOS
# ============================================================

# Tamaño máximo de archivo (MB)
MAX_FILE_SIZE=50

# Ruta de uploads
UPLOAD_PATH=./uploads/

# ============================================================
# NOTAS IMPORTANTES
# ============================================================

# Si usas este archivo:
# 1. Renómbra a .env
# 2. Actualiza los valores según tu entorno
# 3. NO subas el .env real a GitHub (incluye en .gitignore)
# 4. Para producción, usa variables de entorno del servidor
